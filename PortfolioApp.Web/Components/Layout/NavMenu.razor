@inject IJSRuntime JS
@inject IUserProfileService ProfileService
@rendermode InteractiveServer

<header class="site-nav">
    <nav class="container nav-inner" aria-label="Main">
        <a class="brand" href="/">@_brand<span class="brand-dot" aria-hidden="true"></span></a>

        <div class="nav-actions">
            <button type="button" class="icon-btn" @onclick="ToggleDarkMode"
                    aria-label="@(_isDark ? "Switch to light theme" : "Switch to dark theme")"
                    title="@(_isDark ? "Light theme" : "Dark theme")">
                <i class="bi bi-circle-half" aria-hidden="true"></i>
            </button>
            <button class="icon-btn nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#navMain"
                    aria-controls="navMain" aria-expanded="false" aria-label="Open menu">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>
        </div>

        <div class="collapse nav-menu" id="navMain">
            <ul class="nav-links">
                <li><NavLink href="/" Match="NavLinkMatch.All">Home</NavLink></li>
                <li><NavLink href="/projects">Projects</NavLink></li>
                <li><NavLink href="/experience">Experience</NavLink></li>
                <li><NavLink href="/skills">Skills</NavLink></li>
                <li><NavLink href="/qualifications">Education</NavLink></li>
                <li><NavLink href="/cv">CV</NavLink></li>
                <li><NavLink href="/contact">Contact</NavLink></li>
            </ul>
        </div>
    </nav>
</header>

@code {
    private bool _isDark;
    private string _brand = "Portfolio";

    protected override async Task OnInitializedAsync()
    {
        var name = (await ProfileService.GetProfileAsync())?.FullName;
        if (!string.IsNullOrWhiteSpace(name)) _brand = name;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDark = await JS.InvokeAsync<bool>("isDarkMode");
            StateHasChanged();
        }
    }

    private async Task ToggleDarkMode()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync("toggleDarkMode", _isDark);
    }
}
