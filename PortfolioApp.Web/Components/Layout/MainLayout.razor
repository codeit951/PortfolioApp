@inherits LayoutComponentBase
@using Blazored.Toast.Configuration
@inject IUserProfileService ProfileService

@* Interactive toast host: the layout is static, but pages raising toasts run interactively. *@
<BlazoredToasts @rendermode="InteractiveServer" Position="ToastPosition.BottomRight" Timeout="4" ShowProgressBar="false" />

<div class="site d-flex flex-column" style="min-height:100dvh;">
    <NavMenu />

    <main id="main" class="flex-grow-1" tabindex="-1">
        @Body
    </main>

    <footer class="site-footer">
        @if (!string.IsNullOrWhiteSpace(_profile?.FullName))
        {
            <div class="container" aria-hidden="true">
                <p class="footer-mark" data-reveal>@FooterStart<em>@FooterEnd</em></p>
            </div>
        }
        <div class="container footer-inner">
            <span>© @DateTime.UtcNow.Year @_profile?.FullName</span>
            <div class="link-row">
                @if (!string.IsNullOrEmpty(_profile?.Email))
                {
                    <a href="mailto:@_profile.Email">Email</a>
                }
                @if (!string.IsNullOrEmpty(_profile?.GitHubUrl))
                {
                    <a href="@_profile.GitHubUrl" target="_blank" rel="noopener">GitHub</a>
                }
                @if (!string.IsNullOrEmpty(_profile?.LinkedInUrl))
                {
                    <a href="@_profile.LinkedInUrl" target="_blank" rel="noopener">LinkedIn</a>
                }
                @if (!string.IsNullOrEmpty(_profile?.TwitterUrl))
                {
                    <a href="@_profile.TwitterUrl" target="_blank" rel="noopener">X</a>
                }
            </div>
        </div>
    </footer>
</div>

@code {
    private UserProfile? _profile;

    // Large footer wordmark: first name(s) upright, last name in italic.
    private string FooterStart => _profile!.FullName.Contains(' ') ? _profile.FullName[..(_profile.FullName.LastIndexOf(' ') + 1)] : "";
    private string FooterEnd => _profile!.FullName.Contains(' ') ? _profile.FullName[(_profile.FullName.LastIndexOf(' ') + 1)..] : _profile.FullName;

    protected override async Task OnInitializedAsync()
    {
        _profile = await ProfileService.GetProfileAsync();
    }
}
