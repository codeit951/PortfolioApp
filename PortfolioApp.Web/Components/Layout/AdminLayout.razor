@inherits LayoutComponentBase
@using Blazored.Toast.Configuration

@* The layout itself is statically rendered, so the toast host must be its own interactive
   component to receive toasts raised by the interactive admin pages in the same circuit. *@
<BlazoredToasts @rendermode="InteractiveServer" Position="ToastPosition.BottomRight" Timeout="4" ShowProgressBar="false" />

<div class="admin-shell">
    <!-- Mobile top bar (below lg) -->
    <div class="admin-topbar d-flex d-lg-none align-items-center justify-content-between">
        <a href="/admin" class="fw-semibold">Admin</a>
        <button class="icon-btn" type="button" data-bs-toggle="collapse"
                data-bs-target="#adminMobileNav" aria-controls="adminMobileNav" aria-expanded="false" aria-label="Open admin menu">
            <i class="bi bi-list" aria-hidden="true"></i>
        </button>
    </div>
    <div class="collapse d-lg-none admin-mobile-nav" id="adminMobileNav">
        <AdminNavLinks />
    </div>

    <nav class="admin-sidebar d-none d-lg-flex flex-column" aria-label="Admin">
        <a href="/admin" class="admin-brand">Portfolio <small>Admin</small></a>
        <AdminNavLinks />
    </nav>

    <main id="main" class="admin-main" tabindex="-1">
        @Body
    </main>
</div>
