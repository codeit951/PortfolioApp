@page "/qualifications"
@rendermode InteractiveServer
@inject IQualificationService QualService

<PageMeta Title="Education — {name}" Description="Degrees and certifications held by {name}." />

<header class="page-head tone-plum">
    <div class="container">
        <h1 class="page-title reveal">Education</h1>
        <p class="lede reveal-2">Degrees and certifications.</p>
    </div>
</header>

<section class="section">
    <div class="container">
        @if (_loading)
        {
            <div class="skeleton"><span></span><span></span><span></span><span></span></div>
        }
        else if (!_qualifications.Any())
        {
            <div class="empty"><p>No qualifications have been added yet.</p></div>
        }
        else
        {
            <ol class="entries measure" data-reveal>
                @foreach (var qual in _qualifications)
                {
                    <QualificationEntry Qualification="qual" />
                }
            </ol>
        }
    </div>
</section>

@code {
    private List<Qualification> _qualifications = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _qualifications = await QualService.GetAllAsync();
        _loading = false;
    }
}
