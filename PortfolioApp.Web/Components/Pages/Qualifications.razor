@page "/qualifications"
@rendermode InteractiveServer
@inject IQualificationService QualService

<PageTitle>Qualifications — Alex Morgan</PageTitle>
<HeadContent>
    <meta name="description" content="Academic and professional qualifications of Alex Morgan." />
</HeadContent>

<div class="page-hero">
    <div class="container">
        <div class="section-tag">Education</div>
        <h1 class="section-title mt-2">Qualifications</h1>
        <p class="section-subtitle">Degrees, certifications and professional accreditations</p>
    </div>
</div>

<section class="section-py">
    <div class="container" style="max-width:860px;">
        @if (_loading)
        {
            <div class="loading-spinner"><div class="spinner-border text-accent"></div></div>
        }
        else if (!_qualifications.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-mortarboard" style="font-size:3rem;opacity:.3;"></i>
                <p class="mt-3">No qualifications added yet.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var (qual, idx) in _qualifications.Select((q, i) => (q, i)))
                {
                    <div class="col-md-6 fade-in-up" style="animation-delay:@(idx * 0.1)s;">
                        <div class="card qual-card h-100">
                            <div class="card-body">
                                <div class="d-flex gap-3 align-items-start">
                                    <div class="qual-icon">
                                        <i class="bi bi-mortarboard-fill"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-1 mb-1">
                                            <h5 class="mb-0 fw-bold" style="font-size:1rem;">@qual.Title</h5>
                                            <span class="badge badge-accent rounded-pill">@qual.Year</span>
                                        </div>
                                        <div class="text-accent fw-semibold small mb-1">@qual.Institution</div>
                                        @if (!string.IsNullOrEmpty(qual.Grade))
                                        {
                                            <div class="text-muted small mb-1">
                                                <i class="bi bi-award me-1"></i>@qual.Grade
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(qual.Description))
                                        {
                                            <p class="text-secondary mb-0 small mt-2" style="line-height:1.6;">@qual.Description</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<Qualification> _qualifications = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _qualifications = await QualService.GetAllAsync();
        _loading = false;
    }
}
