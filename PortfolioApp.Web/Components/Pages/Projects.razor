@page "/projects"
@rendermode InteractiveServer
@inject IProjectService ProjectService
@implements IDisposable

<PageMeta Title="Projects — {name}" Description="Projects built by {name}." />

<header class="page-head tone-ochre">
    <div class="container">
        <h1 class="page-title reveal">Projects</h1>
        <p class="lede reveal-2">Products, tools and experiments, most recent first.</p>
    </div>
</header>

<section class="section">
    <div class="container">
        <div class="toolbar">
            <div class="search" role="search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" class="form-control" placeholder="Search by name or technology"
                       aria-label="Search projects" value="@_searchTerm" @oninput="OnSearch" />
                @if (!string.IsNullOrEmpty(_searchTerm))
                {
                    <button type="button" class="clear" @onclick="ClearSearch" aria-label="Clear search"><i class="bi bi-x-lg"></i></button>
                }
            </div>
            <div class="count" aria-live="polite">
                @if (_totalCount == 1) { <span>1 project</span> } else { <span>@_totalCount projects</span> }
            </div>
        </div>

        @if (_loading && _projects.Count == 0)
        {
            <div class="skeleton"><span></span><span></span><span></span><span></span></div>
        }
        else if (!_projects.Any())
        {
            <div class="empty">
                @if (string.IsNullOrEmpty(_searchTerm))
                {
                    <p>No projects have been added yet.</p>
                }
                else
                {
                    <p>Nothing matches “@_searchTerm”.</p>
                    <button class="btn-outline-accent" @onclick="ClearSearch">Clear search</button>
                }
            </div>
        }
        else
        {
            <div class="project-grid @(_loading ? "is-busy" : null)">
                @for (var i = 0; i < _projects.Count; i++)
                {
                    <ProjectCard Project="_projects[i]" Index="i" />
                }
            </div>

            @if (_totalPages > 1)
            {
                <nav class="pager" aria-label="Project pages">
                    <button type="button" disabled="@(_page == 1)" @onclick="() => GoToPage(_page - 1)" aria-label="Previous page">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    @for (int i = 1; i <= _totalPages; i++)
                    {
                        var p = i;
                        <button type="button" aria-current="@(p == _page ? "page" : null)" @onclick="() => GoToPage(p)">@p</button>
                    }
                    <button type="button" disabled="@(_page == _totalPages)" @onclick="() => GoToPage(_page + 1)" aria-label="Next page">
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </nav>
            }
        }
    </div>
</section>

@code {
    private List<Project> _projects = new();
    private string _searchTerm = string.Empty;
    private int _page = 1;
    private const int PageSize = 6;
    private int _totalCount;
    private int _totalPages;
    private bool _loading = true;
    private CancellationTokenSource? _debounceCts;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _totalCount = await ProjectService.GetTotalCountAsync(_searchTerm);
        _totalPages = (int)Math.Ceiling(_totalCount / (double)PageSize);
        if (_page > _totalPages && _totalPages > 0) _page = 1;
        _projects = await ProjectService.GetPagedAsync(_page, PageSize, _searchTerm);
        _loading = false;
    }

    // Debounced search: each keystroke cancels the previous pending search.
    private async Task OnSearch(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        _page = 1;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        var cts = _debounceCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, cts.Token);
            await LoadAsync();
        }
        catch (TaskCanceledException)
        {
            // Superseded by a newer keystroke or the page was closed.
        }
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = null;
    }

    private async Task ClearSearch()
    {
        _debounceCts?.Cancel();
        _searchTerm = string.Empty;
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > _totalPages || page == _page) return;
        _page = page;
        await LoadAsync();
    }
}
