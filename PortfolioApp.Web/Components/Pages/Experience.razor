@page "/experience"
@rendermode InteractiveServer
@inject IExperienceService ExperienceService

<PageTitle>Work Experience — Alex Morgan</PageTitle>
<HeadContent>
    <meta name="description" content="Professional work history of Alex Morgan." />
</HeadContent>

<div class="page-hero">
    <div class="container">
        <div class="section-tag">Career</div>
        <h1 class="section-title mt-2">Work Experience</h1>
        <p class="section-subtitle">My professional journey over the years</p>
    </div>
</div>

<section class="section-py">
    <div class="container" style="max-width:800px;">
        @if (_loading)
        {
            <div class="loading-spinner"><div class="spinner-border text-accent"></div></div>
        }
        else if (!_experiences.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-briefcase" style="font-size:3rem;opacity:.3;"></i>
                <p class="mt-3">No experience entries yet.</p>
            </div>
        }
        else
        {
            <div class="timeline">
                @foreach (var exp in _experiences)
                {
                    <div class="timeline-item fade-in-up">
                        <div class="timeline-dot @(exp.IsCurrent ? "active" : "")"></div>
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                                    <div>
                                        <h4 class="mb-0 fw-bold">@exp.Role</h4>
                                        <div class="text-accent fw-semibold fs-5">@exp.Company</div>
                                    </div>
                                    <div>
                                        @if (exp.IsCurrent)
                                        {
                                            <span class="badge bg-success rounded-pill px-3">Currently Here</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill px-3">@exp.EndDate?.Year</span>
                                        }
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap gap-3 text-muted small mb-3">
                                    <span><i class="bi bi-calendar3 me-1 text-accent"></i>
                                        @exp.StartDate.ToString("MMMM yyyy") — @(exp.IsCurrent ? "Present" : exp.EndDate?.ToString("MMMM yyyy"))
                                    </span>
                                    @if (!string.IsNullOrEmpty(exp.Location))
                                    {
                                        <span><i class="bi bi-geo-alt me-1 text-accent"></i>@exp.Location</span>
                                    }
                                </div>
                                <p class="text-secondary mb-0" style="line-height:1.8;">@exp.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<PortfolioApp.Domain.Entities.Experience> _experiences = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _experiences = await ExperienceService.GetAllAsync();
        _loading = false;
    }
}
