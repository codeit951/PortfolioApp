@page "/experience"
@rendermode InteractiveServer
@inject IExperienceService ExperienceService

<PageMeta Title="Experience — {name}" Description="Work history of {name}." />

<header class="page-head tone-slate">
    <div class="container">
        <h1 class="page-title reveal">Experience</h1>
        <p class="lede reveal-2">Where I've worked and what I did there.</p>
    </div>
</header>

<section class="section">
    <div class="container">
        @if (_loading)
        {
            <div class="skeleton"><span></span><span></span><span></span><span></span></div>
        }
        else if (!_experiences.Any())
        {
            <div class="empty"><p>No experience has been added yet.</p></div>
        }
        else
        {
            <ol class="entries measure" data-reveal>
                @foreach (var exp in _experiences)
                {
                    <ExperienceEntry Experience="exp" />
                }
            </ol>
        }
    </div>
</section>

@code {
    private List<PortfolioApp.Domain.Entities.Experience> _experiences = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _experiences = await ExperienceService.GetAllAsync();
        _loading = false;
    }
}
