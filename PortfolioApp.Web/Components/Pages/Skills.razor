@page "/skills"
@rendermode InteractiveServer
@inject ISkillService SkillService

<PageTitle>Skills — Alex Morgan</PageTitle>
<HeadContent>
    <meta name="description" content="Technical skills and proficiency levels of Alex Morgan." />
</HeadContent>

<div class="page-hero">
    <div class="container">
        <div class="section-tag">Expertise</div>
        <h1 class="section-title mt-2">Skills &amp; Technologies</h1>
        <p class="section-subtitle">Tools I use to craft great software</p>
    </div>
</div>

<section class="section-py">
    <div class="container">
        @if (_loading)
        {
            <div class="loading-spinner"><div class="spinner-border text-accent"></div></div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var (category, skills) in _grouped)
                {
                    <div class="col-lg-6 fade-in-up">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="skill-category-header">
                                    <div class="skill-cat-icon">
                                        <i class="bi @GetCategoryIcon(category)"></i>
                                    </div>
                                    <h3 class="h5 mb-0 fw-700">@category</h3>
                                </div>
                                @foreach (var skill in skills)
                                {
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fw-500" style="font-size:.92rem;">
                                                @if (!string.IsNullOrEmpty(skill.IconClass))
                                                {
                                                    <i class="@skill.IconClass me-1 text-accent"></i>
                                                }
                                                @skill.Name
                                            </span>
                                            <span class="text-accent fw-600" style="font-size:.85rem;">@skill.Level%</span>
                                        </div>
                                        <div class="skill-bar-track">
                                            <div class="skill-bar-fill" style="width:@skill.Level%;"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Tag cloud -->
            <div class="text-center mt-5 fade-in-up delay-3">
                <div class="section-tag mb-3">All Technologies</div>
                <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
                    @foreach (var skill in _allSkills)
                    {
                        <span class="tech-tag" style="font-size:.85rem;padding:.35rem .9rem;">
                            @if (!string.IsNullOrEmpty(skill.IconClass))
                            {
                                <i class="@skill.IconClass me-1"></i>
                            }
                            @skill.Name
                        </span>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private Dictionary<string, List<Skill>> _grouped = new();
    private List<Skill> _allSkills = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _grouped = await SkillService.GetGroupedByCategory();
        _allSkills = await SkillService.GetAllAsync();
        _loading = false;
    }

    private static string GetCategoryIcon(string category) => category.ToLower() switch
    {
        "languages"        => "bi-code-slash",
        "frameworks"       => "bi-braces",
        "tools & platforms"=> "bi-tools",
        "databases"        => "bi-database",
        _                  => "bi-star"
    };
}
