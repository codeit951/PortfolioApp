@page "/skills"
@rendermode InteractiveServer
@inject ISkillService SkillService

<PageMeta Title="Skills — {name}" Description="Languages, frameworks and tools {name} works with." />

<header class="page-head tone-sage">
    <div class="container">
        <h1 class="page-title reveal">Skills</h1>
        <p class="lede reveal-2">The languages, frameworks and tools I work with, grouped by how well I know them.</p>
    </div>
</header>

<section class="section">
    <div class="container">
        @if (_loading)
        {
            <div class="skeleton"><span></span><span></span><span></span><span></span></div>
        }
        else if (_grouped.Count == 0)
        {
            <div class="empty"><p>No skills have been added yet.</p></div>
        }
        else
        {
            <div class="split reveal-2">
                <div class="split-label">
                    <p>Each skill is marked Expert, Advanced, Proficient or Familiar, from most to least experience.</p>
                </div>
                <div>
                    @{ var groupIndex = 0; }
                    @foreach (var (category, skills) in _grouped)
                    {
                        <section class="skill-group @Tones[groupIndex++ % Tones.Length]" aria-label="@category" data-reveal>
                            <h2 class="section-title mb-3">@category</h2>
                            <ul class="skill-list">
                                @foreach (var skill in skills)
                                {
                                    var (level, dots) = Level(skill.Level);
                                    <li>
                                        <span class="skill-name">@skill.Name</span>
                                        <span class="skill-level @(dots == 4 ? "is-expert" : null)">
                                            @level
                                            <span class="level-dots" aria-hidden="true">
                                                @for (var d = 1; d <= 4; d++)
                                                {
                                                    <i class="@(d <= dots ? "on" : null)"></i>
                                                }
                                            </span>
                                        </span>
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private Dictionary<string, List<Skill>> _grouped = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _grouped = await SkillService.GetGroupedByCategory();
        _loading = false;
    }

    private static readonly string[] Tones = { "tone-rust", "tone-sage", "tone-slate", "tone-ochre", "tone-plum" };

    private static (string Name, int Dots) Level(int level) => level switch
    {
        >= 85 => ("Expert", 4),
        >= 70 => ("Advanced", 3),
        >= 50 => ("Proficient", 2),
        _ => ("Familiar", 1)
    };
}
