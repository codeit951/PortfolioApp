@page "/Error"
@using System.Diagnostics

<PageTitle>Something went wrong</PageTitle>

<section class="section">
    <div class="container">
        <span class="status-code">500</span>
        <h1 class="page-title no-stop">Something went wrong on our side.</h1>
        <p class="lede mt-3">Please try again in a moment.</p>
        @if (ShowRequestId)
        {
            <p class="text-muted small font-mono">Reference: @RequestId</p>
        }
        <div class="hero-actions mt-4">
            <a href="/" class="btn-accent">Go to the home page</a>
        </div>
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
