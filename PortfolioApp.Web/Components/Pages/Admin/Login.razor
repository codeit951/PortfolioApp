@page "/admin/login"
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authentication
@using System.ComponentModel.DataAnnotations
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject NavigationManager NavigationManager
@inject IToastService Toast

<PageTitle>Admin Login</PageTitle>

<div class="container d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden" style="max-width: 450px; width: 100%;">
        <div class="card-body p-5">
            <div class="text-center mb-5">
                <div class="bg-primary bg-opacity-10 d-inline-block p-3 rounded-circle mb-3">
                    <i class="bi bi-shield-lock-fill text-primary fs-1"></i>
                </div>
                <h2 class="fw-bold">Admin Portal</h2>
                <p class="text-muted">Sign in to manage your portfolio</p>
            </div>

            <EditForm Model="Input" OnValidSubmit="LoginUser" FormName="loginForm">
                
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text  border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                        <InputText @bind-Value="Input.Email" class="form-control  border-start-0" placeholder="admin@portfolio.dev" />
                    </div>
                    <ValidationMessage For="() => Input.Email" class="text-danger small mt-1" />
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between">
                        <label class="form-label fw-semibold">Password</label>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text  border-end-0"><i class="bi bi-key text-muted"></i></span>
                        <InputText @bind-Value="Input.Password" type="password" class="form-control  border-start-0" placeholder="••••••••" />
                    </div>
                    <ValidationMessage For="() => Input.Password" class="text-danger small mt-1" />
                </div>

                <div class="mb-4 form-check">
                    <InputCheckbox @bind-Value="Input.RememberMe" class="form-check-input" id="rememberMe" />
                    <label class="form-check-label text-muted" for="rememberMe">Remember me</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-3 mb-3" disabled="@_loading">
                    @if (_loading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Signing in...</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>
                
                <a href="/" class="btn btn-link w-100 text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Portfolio
                </a>
            </EditForm>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger mt-3 small border-0" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm(FormName = "loginForm")]
    private LoginInput Input { get; set; } = new();

    private string? _errorMessage;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        var authState = await SignInManager.Context.AuthenticateAsync(IdentityConstants.ApplicationScheme);
        if (authState.Succeeded)
        {
            NavigationManager.NavigateTo("/admin", true);
        }
    }

    private async Task LoginUser()
    {
        _loading = true;
        _errorMessage = null;
        bool success = false;

        try
        {
            var result = await SignInManager.PasswordSignInAsync(Input.Email, Input.Password, Input.RememberMe, lockoutOnFailure: false);
            if (result.Succeeded)
            {
                success = true;
            }
            else
            {
                _errorMessage = "Invalid login attempt. Please check your credentials.";
                Toast.ShowError("Login failed");
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "An error occurred during login.";
            Toast.ShowError("Error: " + ex.Message);
        }
        finally
        {
            _loading = false;
        }

        if (success)
        {
            Toast.ShowSuccess("Welcome back!");
            NavigationManager.NavigateTo("/admin", true);
        }
    }

    public class LoginInput
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
