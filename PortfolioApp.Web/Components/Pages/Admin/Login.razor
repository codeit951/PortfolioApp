@page "/admin/login"
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authentication
@using System.ComponentModel.DataAnnotations
@inject SignInManager<IdentityUser> SignInManager
@inject NavigationManager NavigationManager
@inject ILogger<Login> Logger
@layout Layout.AuthLayout

@* Statically rendered (no interactive render mode): signing in must write the auth cookie,
   which requires a real HTTP request. *@

<PageTitle>Sign in · Admin</PageTitle>

<div class="auth-card">
    <a href="/" class="text-link small d-inline-block mb-4"><span aria-hidden="true">←</span> Back to the site</a>

    <h1 class="page-title mb-2">Sign in</h1>
    <p class="text-muted mb-4">Manage your portfolio content.</p>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger small" role="alert">@_errorMessage</div>
    }

    <EditForm Model="Input" OnValidSubmit="LoginUser" FormName="loginForm" class="panel">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label" for="email">Email</label>
            <InputText id="email" type="email" @bind-Value="Input.Email" class="form-control" autocomplete="username" />
            <ValidationMessage For="() => Input.Email" class="small mt-1" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <InputText id="password" @bind-Value="Input.Password" type="password" class="form-control" autocomplete="current-password" />
            <ValidationMessage For="() => Input.Password" class="small mt-1" />
        </div>

        <div class="mb-4 form-check">
            <InputCheckbox @bind-Value="Input.RememberMe" class="form-check-input" id="rememberMe" />
            <label class="form-check-label text-ink-2" for="rememberMe">Keep me signed in</label>
        </div>

        <button type="submit" class="btn-accent w-100 justify-content-center">Sign in</button>

        @if (_externalSchemes.Count > 0)
        {
            <div class="d-flex align-items-center gap-3 my-3 text-muted small">
                <hr class="flex-grow-1 m-0" /><span>or</span><hr class="flex-grow-1 m-0" />
            </div>
            <div class="d-grid gap-2">
                @foreach (var scheme in _externalSchemes)
                {
                    <a class="btn-outline-accent justify-content-center" href="/admin/external-login/@scheme.Name">
                        <i class="bi @(scheme.Name == "GitHub" ? "bi-github" : "bi-google")" aria-hidden="true"></i>Continue with @(scheme.DisplayName ?? scheme.Name)
                    </a>
                }
            </div>
        }
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm(FormName = "loginForm")]
    private LoginInput Input { get; set; } = new();

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "error")] private string? ErrorCode { get; set; }

    private string? _errorMessage;
    private List<AuthenticationScheme> _externalSchemes = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await SignInManager.Context.AuthenticateAsync(IdentityConstants.ApplicationScheme);
        if (authState.Succeeded && HttpMethods.IsGet(SignInManager.Context.Request.Method))
        {
            NavigationManager.NavigateTo(SafeReturnUrl, forceLoad: true);
            return;
        }

        _externalSchemes = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToList();
        _errorMessage = ErrorCode switch
        {
            "denied" => "That account isn't linked to an admin user.",
            "locked" => "This account is temporarily locked. Try again later.",
            "external" or "provider" => "External sign-in failed. Please try again.",
            _ => null
        };
    }

    // Only allow redirects back into this site's admin area.
    private string SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith("/admin", StringComparison.OrdinalIgnoreCase)
            && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl
            : "/admin";

    private async Task LoginUser()
    {
        var result = await SignInManager.PasswordSignInAsync(Input.Email, Input.Password, Input.RememberMe, lockoutOnFailure: true);
        if (result.Succeeded)
        {
            NavigationManager.NavigateTo(SafeReturnUrl, forceLoad: true);
            return;
        }

        if (result.IsLockedOut)
        {
            Logger.LogWarning("Locked-out sign-in attempt for {Email}", Input.Email);
            _errorMessage = "Too many failed attempts. This account is locked for 15 minutes.";
        }
        else
        {
            _errorMessage = "Invalid login attempt. Please check your credentials.";
        }
    }

    public class LoginInput
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
