@page "/admin"
@layout Layout.AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject IProjectService ProjectService
@inject IMessageService MessageService
@inject ISkillService SkillService
@inject IExperienceService ExperienceService

<PageTitle>Overview · Admin</PageTitle>

<div class="mb-4">
    <h1 class="h2 fw-semibold mb-1">Overview</h1>
    <p class="text-muted mb-0">Your site at a glance.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <a href="/admin/projects" class="card stat-tile d-block h-100">
            <div class="value">@_projectCount</div>
            <div class="label">Projects</div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="/admin/messages" class="card stat-tile d-block h-100">
            <div class="value">@_totalMessages</div>
            <div class="label">
                Messages
                @if (_unreadMessages > 0)
                {
                    <span class="tag-now ms-1">@_unreadMessages unread</span>
                }
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="/admin/skills" class="card stat-tile d-block h-100">
            <div class="value">@_skillCount</div>
            <div class="label">Skills</div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="/admin/experience" class="card stat-tile d-block h-100">
            <div class="value">@_experienceCount</div>
            <div class="label">Roles</div>
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 fw-semibold mb-0">Recent messages</h2>
                    <a href="/admin/messages" class="text-link small">Open inbox</a>
                </div>
                @if (_recentMessages is null)
                {
                    <div class="skeleton"><span></span><span></span><span></span></div>
                }
                else if (!_recentMessages.Any())
                {
                    <p class="text-muted mb-0 py-3">No messages yet. They'll appear here when someone uses the contact form.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var msg in _recentMessages)
                        {
                            <li class="d-flex justify-content-between gap-3 py-3 border-top">
                                <div class="text-truncate">
                                    <div class="@(msg.IsRead ? "" : "fw-semibold")">
                                        @msg.Name
                                        @if (!msg.IsRead) { <span class="tag-now">New</span> }
                                    </div>
                                    <div class="text-muted small text-truncate">@(string.IsNullOrWhiteSpace(msg.Subject) ? msg.Content : msg.Subject)</div>
                                </div>
                                <div class="text-muted small text-nowrap tabular">@msg.CreatedAt.ToLocalTime().ToString("d MMM")</div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body p-4">
                <h2 class="h6 fw-semibold mb-3">Shortcuts</h2>
                <div class="d-grid gap-2">
                    <a href="/admin/projects" class="btn btn-light text-start"><i class="bi bi-plus me-1" aria-hidden="true"></i>Add a project</a>
                    <a href="/admin/experience" class="btn btn-light text-start"><i class="bi bi-plus me-1" aria-hidden="true"></i>Add a role</a>
                    <a href="/admin/profile" class="btn btn-light text-start"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit profile</a>
                    <a href="/" class="btn btn-light text-start" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Open the site</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int _projectCount;
    private int _unreadMessages;
    private int _totalMessages;
    private int _skillCount;
    private int _experienceCount;
    private List<Message>? _recentMessages;

    protected override async Task OnInitializedAsync()
    {
        _projectCount = await ProjectService.GetTotalCountAsync();
        _unreadMessages = await MessageService.GetUnreadCountAsync();

        var allMessages = await MessageService.GetAllAsync();
        _totalMessages = allMessages.Count;
        _recentMessages = allMessages.Take(5).ToList();

        _skillCount = (await SkillService.GetAllAsync()).Count;
        _experienceCount = (await ExperienceService.GetAllAsync()).Count;
    }
}
