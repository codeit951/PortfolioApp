@page "/admin"
@layout Layout.AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject IProjectService ProjectService
@inject IMessageService MessageService
@inject ISkillService SkillService
@inject IExperienceService ExperienceService

<PageTitle>Admin Dashboard</PageTitle>

<div class="mb-4">
    <h2 class="fw-bold">Dashboard</h2>
    <p class="text-muted">Overview of your portfolio's performance and content</p>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-3">
                        <i class="bi bi-grid-fill text-primary fs-4"></i>
                    </div>
                    <span class="badge bg-primary rounded-pill">Total</span>
                </div>
                <h3 class="fw-bold mb-1">@_projectCount</h3>
                <p class="text-muted small mb-0">Portfolio Projects</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="bg-success bg-opacity-10 p-3 rounded-3">
                        <i class="bi bi-envelope-fill text-success fs-4"></i>
                    </div>
                    @if (_unreadMessages > 0)
                    {
                        <span class="badge bg-danger rounded-pill">@_unreadMessages New</span>
                    }
                </div>
                <h3 class="fw-bold mb-1">@_totalMessages</h3>
                <p class="text-muted small mb-0">Total Messages</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="bg-info bg-opacity-10 p-3 rounded-3">
                        <i class="bi bi-lightning-fill text-info fs-4"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-1">@_skillCount</h3>
                <p class="text-muted small mb-0">Skills Tracked</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="bg-warning bg-opacity-10 p-3 rounded-3">
                        <i class="bi bi-briefcase-fill text-warning fs-4"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-1">@_experienceCount</h3>
                <p class="text-muted small mb-0">Work Experiences</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Recent Messages</h5>
                <a href="/admin/messages" class="btn btn-sm btn-light rounded-pill px-3">View All</a>
            </div>
            <div class="card-body p-4">
                @if (_recentMessages == null)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                }
                else if (!_recentMessages.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-chat-dots text-muted fs-1"></i>
                        <p class="text-muted mt-2">No messages yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Sender</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var msg in _recentMessages)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@msg.Name</div>
                                            <div class="text-muted small">@msg.Email</div>
                                        </td>
                                        <td class="small">@msg.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                        <td>
                                            @if (msg.IsRead)
                                            {
                                                <span class="badge bg-light text-muted border">Read</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">New</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a href="/admin/messages" class="btn btn-sm btn-outline-primary rounded-circle">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">Quick Actions</h5>
            </div>
            <div class="card-body p-4">
                <div class="d-grid gap-3">
                    <a href="/admin/projects" class="btn btn-outline-primary text-start p-3 rounded-3 d-flex align-items-center">
                        <i class="bi bi-plus-circle-fill me-3 fs-5"></i>
                        <div>
                            <div class="fw-bold">Add Project</div>
                            <div class="small text-muted">Showcase your latest work</div>
                        </div>
                    </a>
                    <a href="/admin/profile" class="btn btn-outline-info text-start p-3 rounded-3 d-flex align-items-center">
                        <i class="bi bi-person-fill-gear me-3 fs-5"></i>
                        <div>
                            <div class="fw-bold">Update Profile</div>
                            <div class="small text-muted">Keep your bio up to date</div>
                        </div>
                    </a>
                    <a href="/admin/experience" class="btn btn-outline-warning text-start p-3 rounded-3 d-flex align-items-center">
                        <i class="bi bi-award-fill me-3 fs-5"></i>
                        <div>
                            <div class="fw-bold">Log Experience</div>
                            <div class="small text-muted">Add a new career milestone</div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int _projectCount;
    private int _unreadMessages;
    private int _totalMessages;
    private int _skillCount;
    private int _experienceCount;
    private List<Message>? _recentMessages;

    protected override async Task OnInitializedAsync()
    {
        _projectCount = await ProjectService.GetTotalCountAsync();
        _unreadMessages = await MessageService.GetUnreadCountAsync();
        
        var allMessages = await MessageService.GetAllAsync();
        _totalMessages = allMessages.Count;
        _recentMessages = allMessages.Take(5).ToList();
        
        _skillCount = (await SkillService.GetAllAsync()).Count;
        _experienceCount = (await ExperienceService.GetAllAsync()).Count;
    }
}
