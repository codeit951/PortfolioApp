@page "/admin/profile"
@layout Layout.AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject IUserProfileService ProfileService
@inject IToastService Toast
@inject FileStorageService Storage
@inject ILogger<ProfileManager> Logger
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Manage Profile</PageTitle>

<div class="mb-4">
    <h1 class="h2 fw-semibold mb-1">Profile</h1>
    <p class="text-muted">Name, bio, photo, CV and contact links.</p>
</div>

@if (_profile == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-3 p-md-5">
            <EditForm Model="_profile" OnValidSubmit="SaveProfile" FormName="profileForm">
                <DataAnnotationsValidator />

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Full Name</label>
                        <InputText @bind-Value="_profile.FullName" class="form-control" placeholder="Your name" />
                        <ValidationMessage For="() => _profile.FullName" class="text-danger small mt-1" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Job Title</label>
                        <InputText @bind-Value="_profile.Title" class="form-control" placeholder="Full Stack Developer" />
                        <ValidationMessage For="() => _profile.Title" class="text-danger small mt-1" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Email Address</label>
                        <InputText @bind-Value="_profile.Email" class="form-control" placeholder="you@example.com" />
                        <ValidationMessage For="() => _profile.Email" class="text-danger small mt-1" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Phone Number</label>
                        <InputText @bind-Value="_profile.Phone" class="form-control" placeholder="Optional" />
                        <ValidationMessage For="() => _profile.Phone" class="text-danger small mt-1" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Location</label>
                        <InputText @bind-Value="_profile.Location" class="form-control" placeholder="City, Country" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Profile Image</label>
                        <div class="d-flex align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(_profile.ProfileImageUrl))
                            {
                                <img src="@_profile.ProfileImageUrl" alt="Profile" class="rounded-circle shadow-sm" style="width: 64px; height: 64px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center text-muted" style="width: 64px; height: 64px; border: 2px dashed #ccc;">
                                    <i class="bi bi-person fs-3"></i>
                                </div>
                            }
                            <div class="flex-grow-1">
                                <InputFile OnChange="HandleProfileImageUpload" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp" />
                                <div class="form-text small">JPG, PNG or WebP, max 2MB</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">CV / Résumé (PDF)</label>
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(_profile.CvFileUrl))
                            {
                                <a href="@_profile.CvFileUrl" target="_blank" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-file-earmark-pdf me-1"></i>View current CV
                                </a>
                                <button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => _profile.CvFileUrl = string.Empty">Remove</button>
                            }
                            else
                            {
                                <span class="text-muted small">No CV uploaded — the Download button is hidden.</span>
                            }
                            <div class="flex-grow-1" style="min-width:220px;">
                                <InputFile OnChange="HandleCvUpload" class="form-control form-control-sm" accept=".pdf,application/pdf" />
                                <div class="form-text small">PDF, max 10MB</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">GitHub URL</label>
                        <InputText @bind-Value="_profile.GitHubUrl" class="form-control" placeholder="https://github.com/..." />
                        <ValidationMessage For="() => _profile.GitHubUrl" class="text-danger small mt-1" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">LinkedIn URL</label>
                        <InputText @bind-Value="_profile.LinkedInUrl" class="form-control" placeholder="https://linkedin.com/in/..." />
                        <ValidationMessage For="() => _profile.LinkedInUrl" class="text-danger small mt-1" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Twitter / X URL</label>
                        <InputText @bind-Value="_profile.TwitterUrl" class="form-control" placeholder="https://x.com/..." />
                        <ValidationMessage For="() => _profile.TwitterUrl" class="text-danger small mt-1" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Short Bio (Hero Section)</label>
                        <InputTextArea @bind-Value="_profile.Bio" class="form-control" rows="3" placeholder="A brief introduction..." />
                        <ValidationMessage For="() => _profile.Bio" class="text-danger small mt-1" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Detailed Summary (CV Page)</label>
                        <InputTextArea @bind-Value="_profile.Summary" class="form-control" rows="5" placeholder="More detailed professional summary..." />
                        <ValidationMessage For="() => _profile.Summary" class="text-danger small mt-1" />
                    </div>

                    <div class="col-12 mt-5">
                        <hr class="mb-4" />
                        <button type="submit" class="btn btn-primary px-5 py-2 fw-semibold" disabled="@(_saving || _uploading)">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Saving…</span>
                            }
                            else
                            {
                                <span>Save profile</span>
                            }
                        </button>
                        <div class="form-text small mt-2">Uploaded files are only kept once you save.</div>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private UserProfile? _profile;
    private bool _saving;
    private bool _uploading;
    private UploadTracker _imageUploads = default!;
    private UploadTracker _cvUploads = default!;

    protected override async Task OnInitializedAsync()
    {
        _imageUploads = new UploadTracker(Storage);
        _cvUploads = new UploadTracker(Storage);

        _profile = await ProfileService.GetProfileAsync() ?? new UserProfile();
        _imageUploads.Begin(_profile.ProfileImageUrl);
        _cvUploads.Begin(_profile.CvFileUrl);
    }

    private async Task SaveProfile()
    {
        if (_profile == null || _uploading) return;

        _saving = true;
        try
        {
            _profile = await ProfileService.UpsertProfileAsync(_profile);
            _imageUploads.Commit(_profile.ProfileImageUrl);
            _cvUploads.Commit(_profile.CvFileUrl);
            Toast.ShowSuccess("Profile updated successfully!");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save profile");
            Toast.ShowError("Failed to update profile. Please try again.");
        }
        finally
        {
            _saving = false;
        }
    }

    private Task HandleProfileImageUpload(InputFileChangeEventArgs e) =>
        Upload(e.File, "profile", UploadKind.Image, 2 * 1024 * 1024, _imageUploads,
            url => _profile!.ProfileImageUrl = url, "Profile image uploaded");

    private Task HandleCvUpload(InputFileChangeEventArgs e) =>
        Upload(e.File, "cv", UploadKind.Pdf, 10 * 1024 * 1024, _cvUploads,
            url => _profile!.CvFileUrl = url, "CV uploaded — save to publish it");

    private async Task Upload(IBrowserFile file, string folder, UploadKind kind, long maxBytes,
        UploadTracker tracker, Action<string> apply, string successMessage)
    {
        if (_profile is null) return;
        _uploading = true;
        try
        {
            var url = await Storage.SaveAsync(file, folder, kind, maxBytes);
            tracker.Track(url);
            apply(url);
            Toast.ShowInfo(successMessage);
        }
        catch (UploadRejectedException ex)
        {
            Toast.ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Profile upload to {Folder} failed", folder);
            Toast.ShowError("Upload failed. Please try another file.");
        }
        finally
        {
            _uploading = false;
        }
    }

    public void Dispose()
    {
        // Leaving without saving discards the uploaded files.
        _imageUploads?.Rollback();
        _cvUploads?.Rollback();
    }
}
