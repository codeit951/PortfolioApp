@page "/admin/messages"
@layout Layout.AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject IMessageService MessageService
@inject IToastService Toast
@rendermode InteractiveServer

<PageTitle>Manage Messages</PageTitle>

<div class="mb-4">
    <h1 class="h2 fw-semibold mb-1">Messages</h1>
    <p class="text-muted">Messages sent through the contact form.</p>
</div>

@if (_messages == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (!_messages.Any())
{
    <div class="card border-0 shadow-sm rounded-4 text-center py-5">
        <div class="card-body">
            <i class="bi bi-chat-dots text-muted fs-1"></i>
            <p class="text-muted mt-3">No messages yet.</p>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Sender</th>
                        <th>Subject</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var msg in _messages)
                    {
                        <tr class="@(msg.IsRead ? "" : "table-primary fw-semibold")" style="cursor: pointer;" @onclick="() => ViewMessage(msg)">
                            <td class="ps-4">
                                <div>@msg.Name</div>
                                <div class="text-muted small fw-normal">@msg.Email</div>
                            </td>
                            <td>@msg.Subject</td>
                            <td>@msg.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                @if (msg.IsRead)
                                {
                                    <span class="badge bg-light text-muted border fw-normal">Read</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">New</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-outline-danger" @onclick:stopPropagation="true" @onclick="() => DeleteMessage(msg.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (_selectedMessage != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0 pt-4 px-4">
                    <h5 class="modal-title fw-semibold">Message</h5>
                    <button type="button" class="btn-close" @onclick="() => _selectedMessage = null"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="bg-light-subtle rounded-4 p-4 mb-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="small text-muted mb-1">From</div>
                                <div class="fw-semibold">@_selectedMessage.Name</div>
                                <div class="small">@_selectedMessage.Email</div>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <div class="small text-muted mb-1">Received On</div>
                                <div class="fw-semibold">@_selectedMessage.CreatedAt.ToLocalTime().ToString("MMMM dd, yyyy HH:mm")</div>
                            </div>
                            <div class="col-12 mt-3 pt-3 border-top">
                                <div class="small text-muted mb-1">Subject</div>
                                <div class="fw-semibold">@_selectedMessage.Subject</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="px-2">
                        <div class="small text-muted mb-2">Message Content</div>
                        <div class="p-3 bg-secondary border rounded-3" style="white-space: pre-wrap; min-height: 150px;">@_selectedMessage.Content</div>
                    </div>
                </div>
                <div class="modal-footer border-0 pb-4 px-4">
                    <a href="mailto:@_selectedMessage.Email" class="btn btn-primary px-4">
                        Reply by email
                    </a>
                    <button type="button" class="btn btn-light px-4" @onclick="() => _selectedMessage = null">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Message>? _messages;
    private Message? _selectedMessage;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData() => _messages = await MessageService.GetAllAsync();

    private async Task ViewMessage(Message msg)
    {
        _selectedMessage = msg;
        if (!msg.IsRead)
        {
            await MessageService.MarkAsReadAsync(msg.Id);
            await LoadData();
        }
    }

    private async Task DeleteMessage(int id)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Delete this message?"))
        {
            await MessageService.DeleteAsync(id);
            Toast.ShowSuccess("Message deleted");
            _selectedMessage = null;
            await LoadData();
        }
    }

    [Inject] IJSRuntime JS { get; set; } = default!;
}
