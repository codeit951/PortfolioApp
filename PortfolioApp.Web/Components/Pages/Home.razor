@page "/"
@rendermode InteractiveServer
@inject IUserProfileService ProfileService
@inject IExperienceService ExperienceService
@inject IProjectService ProjectService
@inject ISkillService SkillService

<PageTitle>Alex Morgan — Senior Full Stack Developer</PageTitle>
<HeadContent>
    <meta name="description" content="Alex Morgan — Senior Full Stack Developer specialising in .NET, Blazor and cloud-native applications." />
</HeadContent>

@if (_loading)
{
    <div class="loading-spinner"><div class="spinner-border text-accent" role="status"></div></div>
}
else if (_profile is not null)
{
    <!-- ── Hero ──────────────────────────────────────────────── -->
    <section class="hero-section section-py">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-7 fade-in-up">
                    <div class="hero-subtitle mb-3 font-mono">
                        <span class="text-muted">&gt; </span>@_profile.Title
                    </div>
                    <h1 class="hero-title mb-4">@_profile.FullName</h1>
                    <p class="hero-bio mb-4">@_profile.Bio</p>

                    <div class="d-flex flex-wrap gap-3 mb-4">
                        <a href="/cv" class="btn btn-accent">
                            <i class="bi bi-download me-2"></i>Download CV
                        </a>
                        <a href="/contact" class="btn btn-outline-accent">
                            <i class="bi bi-envelope me-2"></i>Get In Touch
                        </a>
                    </div>

                    <div class="d-flex gap-2 mt-2">
                        @if (!string.IsNullOrEmpty(_profile.GitHubUrl))
                        {
                            <a href="@_profile.GitHubUrl" target="_blank" class="social-btn" title="GitHub">
                                <i class="bi bi-github"></i>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(_profile.LinkedInUrl))
                        {
                            <a href="@_profile.LinkedInUrl" target="_blank" class="social-btn" title="LinkedIn">
                                <i class="bi bi-linkedin"></i>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(_profile.TwitterUrl))
                        {
                            <a href="@_profile.TwitterUrl" target="_blank" class="social-btn" title="Twitter/X">
                                <i class="bi bi-twitter-x"></i>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(_profile.Email))
                        {
                            <a href="mailto:@_profile.Email" class="social-btn" title="Email">
                                <i class="bi bi-envelope-fill"></i>
                            </a>
                        }
                    </div>
                </div>
                <div class="col-lg-5 text-center fade-in-up delay-2">
                    <img src="@_profile.ProfileImageUrl" alt="@_profile.FullName"
                         class="hero-avatar"
                         onerror="this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(_profile.FullName)&size=260&background=6c63ff&color=fff&bold=true'" />
                </div>
            </div>
        </div>
    </section>

    <!-- ── Stats ─────────────────────────────────────────────── -->
    <section style="background:var(--bg-card);border-top:1px solid var(--border-color);border-bottom:1px solid var(--border-color);">
        <div class="container py-4">
            <div class="row g-0 text-center">
                <div class="col-6 col-md-3 stat-card border-end border-bottom border-md-bottom-0">
                    <div class="stat-number">8+</div>
                    <div class="stat-label">Years Experience</div>
                </div>
                <div class="col-6 col-md-3 stat-card border-md-end border-bottom border-md-bottom-0">
                    <div class="stat-number">@_projectCount</div>
                    <div class="stat-label">Projects Built</div>
                </div>
                <div class="col-6 col-md-3 stat-card border-end">
                    <div class="stat-number">@_skillCount</div>
                    <div class="stat-label">Technologies</div>
                </div>
                <div class="col-6 col-md-3 stat-card">
                    <div class="stat-number">3</div>
                    <div class="stat-label">Companies</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ── Recent Experience ─────────────────────────────────── -->
    <section class="section-py">
        <div class="container">
            <div class="section-header fade-in-up">
                <div class="section-tag">Career</div>
                <h2 class="section-title">Work Experience</h2>
                <div class="section-divider"></div>
                <p class="section-subtitle">Where I've made an impact</p>
            </div>
            <div class="timeline fade-in-up delay-2">
                @foreach (var exp in _experiences.Take(3))
                {
                    <div class="timeline-item">
                        <div class="timeline-dot @(exp.IsCurrent ? "active" : "")"></div>
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                    <div>
                                        <h5 class="mb-0 fw-700">@exp.Role</h5>
                                        <div class="text-accent fw-600">@exp.Company</div>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge @(exp.IsCurrent ? "bg-success" : "bg-secondary") rounded-pill">
                                            @(exp.IsCurrent ? "Current" : exp.EndDate?.Year.ToString())
                                        </span>
                                        <div class="text-muted small mt-1">@exp.StartDate.ToString("MMM yyyy") — @(exp.IsCurrent ? "Present" : exp.EndDate?.ToString("MMM yyyy"))</div>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(exp.Location))
                                {
                                    <div class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i>@exp.Location</div>
                                }
                                <p class="text-secondary mb-0" style="font-size:.92rem;">@exp.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="text-center mt-4 fade-in-up delay-4">
                <a href="/experience" class="btn btn-outline-accent">View Full History <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div>
    </section>

    <!-- ── Featured Projects ──────────────────────────────────── -->
    <section class="section-py" style="background:var(--bg-card);">
        <div class="container">
            <div class="section-header fade-in-up">
                <div class="section-tag">Portfolio</div>
                <h2 class="section-title">Featured Projects</h2>
                <div class="section-divider"></div>
                <p class="section-subtitle">Selected work I'm proud of</p>
            </div>
            <div class="row g-4">
                @foreach (var project in _projects)
                {
                    <div class="col-md-6 col-lg-4 fade-in-up delay-2">
                        <div class="card project-card h-100" style="position:relative;">
                            @if (project.IsFeatured)
                            {
                                <span class="featured-badge"><i class="bi bi-star-fill me-1"></i>Featured</span>
                            }
                            <div class="project-img">
                                @if (!string.IsNullOrEmpty(project.ImageUrl))
                                {
                                    <img src="@project.ImageUrl" alt="@project.Title" class="w-100 h-100" style="object-fit: cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-code-slash text-muted opacity-25"></i>
                                }
                            </div>
                            <div class="card-body">
                                <h5 class="fw-700 mb-2">@project.Title</h5>
                                <p class="text-secondary small mb-3" style="flex:1;">@project.Description</p>
                                <div class="mb-3">
                                    @foreach (var tech in project.TechStack.Split(','))
                                    {
                                        <span class="tech-tag">@tech.Trim()</span>
                                    }
                                </div>
                                <div class="d-flex gap-2 mt-auto">
                                    @if (!string.IsNullOrEmpty(project.GitHubUrl))
                                    {
                                        <a href="@project.GitHubUrl" target="_blank" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-github me-1"></i>Code
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(project.DemoUrl))
                                    {
                                        <a href="@project.DemoUrl" target="_blank" class="btn btn-sm btn-accent">
                                            <i class="bi bi-box-arrow-up-right me-1"></i>Live Demo
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="text-center mt-5 fade-in-up delay-4">
                <a href="/projects" class="btn btn-accent">See All Projects <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div>
    </section>
}

@code {
    private UserProfile? _profile;
    private List<PortfolioApp.Domain.Entities.Experience> _experiences = new();
    private List<Project> _projects = new();
    private int _projectCount;
    private int _skillCount;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _profile = await ProfileService.GetProfileAsync();
        _experiences = await ExperienceService.GetAllAsync();
        _projects = (await ProjectService.GetAllAsync()).Where(p => p.IsFeatured).Take(3).ToList();
        _projectCount = await ProjectService.GetTotalCountAsync();
        var skills = await SkillService.GetAllAsync();
        _skillCount = skills.Count;
        _loading = false;
    }
}
