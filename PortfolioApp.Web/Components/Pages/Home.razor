@page "/"
@rendermode InteractiveServer
@inject IUserProfileService ProfileService
@inject IExperienceService ExperienceService
@inject IProjectService ProjectService
@inject ISkillService SkillService

<PageMeta Title="" Description="{name} — {title}." />

@if (_loading)
{
    <section class="hero"><div class="container"><div class="skeleton"><span></span><span></span><span></span><span></span></div></div></section>
}
else if (_profile is null)
{
    <section class="hero">
        <div class="container">
            <h1 class="page-title">This site is being set up</h1>
            <p class="lede mt-3">Check back soon.</p>
        </div>
    </section>
}
else
{
    <section class="hero">
        <div class="container hero-grid">
            <div>
                <div class="hero-role reveal">
                    <span class="role-dot" aria-hidden="true"></span>
                    <span>@_profile.Title</span>
                    @if (!string.IsNullOrEmpty(_profile.Location))
                    {
                        <span class="sep" aria-hidden="true">/</span>
                        <span>@_profile.Location</span>
                    }
                </div>
                <h1 class="display reveal-2">@_nameStart<em>@_nameEnd</em></h1>
                @if (!string.IsNullOrEmpty(_profile.Bio))
                {
                    <p class="lede reveal-3">@_profile.Bio</p>
                }
                <div class="hero-actions reveal-3">
                    <a href="/contact" class="btn-accent">Get in touch</a>
                    @if (!string.IsNullOrEmpty(_profile.CvFileUrl))
                    {
                        <a href="@_profile.CvFileUrl" download class="btn-outline-accent">Download CV</a>
                    }
                    else
                    {
                        <a href="/cv" class="btn-outline-accent">View CV</a>
                    }
                    <div class="link-row">
                        @if (!string.IsNullOrEmpty(_profile.GitHubUrl))
                        {
                            <a href="@_profile.GitHubUrl" target="_blank" rel="noopener" class="text-link">GitHub <span class="arrow" aria-hidden="true">↗</span></a>
                        }
                        @if (!string.IsNullOrEmpty(_profile.LinkedInUrl))
                        {
                            <a href="@_profile.LinkedInUrl" target="_blank" rel="noopener" class="text-link">LinkedIn <span class="arrow" aria-hidden="true">↗</span></a>
                        }
                        @if (!string.IsNullOrEmpty(_profile.TwitterUrl))
                        {
                            <a href="@_profile.TwitterUrl" target="_blank" rel="noopener" class="text-link">X <span class="arrow" aria-hidden="true">↗</span></a>
                        }
                    </div>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_profile.ProfileImageUrl))
            {
                <div class="portrait-frame reveal-2">
                    <img src="@_profile.ProfileImageUrl" alt="Portrait of @_profile.FullName" class="portrait"
                         onerror="this.parentElement.style.display='none'" />
                </div>
            }
        </div>

        <div class="container mt-5">
            <dl class="facts reveal-3">
                <div class="fact"><dt>Years of experience</dt><dd>@(_yearsExperience > 0 ? _yearsExperience.ToString() : "<1")</dd></div>
                <div class="fact"><dt>Projects</dt><dd>@_projectCount</dd></div>
                <div class="fact"><dt>Technologies</dt><dd>@_skillCount</dd></div>
                <div class="fact"><dt>@(_companyCount == 1 ? "Company" : "Companies")</dt><dd>@_companyCount</dd></div>
            </dl>
        </div>
    </section>

    @if (_projects.Count > 0)
    {
        <section class="section">
            <div class="container">
                <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-5 tone-ochre" data-reveal>
                    <div>
                        <span class="eyebrow">Selected work</span>
                        <h2 class="section-title">Featured projects</h2>
                    </div>
                    <a href="/projects" class="text-link">All projects <span class="arrow" aria-hidden="true">→</span></a>
                </div>
                <div class="project-grid">
                    @for (var i = 0; i < _projects.Count; i++)
                    {
                        <ProjectCard Project="_projects[i]" Index="i" />
                    }
                </div>
            </div>
        </section>
    }

    @if (_experiences.Count > 0)
    {
        <section class="section">
            <div class="container split tone-slate">
                <div class="split-label" data-reveal>
                    <h2 class="section-title">Experience</h2>
                    <p>Recent roles. The full history is on the <a href="/experience" class="text-link">experience page</a>.</p>
                </div>
                <ol class="entries" data-reveal style="--i:1">
                    @foreach (var exp in _experiences.Take(3))
                    {
                        <ExperienceEntry Experience="exp" />
                    }
                </ol>
            </div>
        </section>
    }

    <section class="section">
        <div class="container">
            <div class="cta-band" data-reveal>
                <div>
                    <h2>Say hello</h2>
                    <p>Have a project, a role or a question in mind? Send a message and I'll get back to you.</p>
                </div>
                <div class="hero-actions">
                    <a href="/contact" class="btn-accent">Send a message <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                    @if (!string.IsNullOrEmpty(_profile.Email))
                    {
                        <a href="mailto:@_profile.Email" class="text-link">@_profile.Email</a>
                    }
                </div>
            </div>
        </div>
    </section>
}

@code {
    private UserProfile? _profile;

    // "Peter Anthony" -> "Peter " + "Anthony"; the last word is set in italic accent.
    private string _nameStart => _profile is null ? "" :
        _profile.FullName.Contains(' ') ? _profile.FullName[..(_profile.FullName.LastIndexOf(' ') + 1)] : "";
    private string _nameEnd => _profile is null ? "" :
        _profile.FullName.Contains(' ') ? _profile.FullName[(_profile.FullName.LastIndexOf(' ') + 1)..] : _profile.FullName;
    private List<PortfolioApp.Domain.Entities.Experience> _experiences = new();
    private List<Project> _projects = new();
    private int _projectCount;
    private int _skillCount;
    private int _yearsExperience;
    private int _companyCount;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _profile = await ProfileService.GetProfileAsync();
        _experiences = await ExperienceService.GetAllAsync();

        var allProjects = await ProjectService.GetAllAsync();
        _projectCount = allProjects.Count;
        _projects = allProjects.Where(p => p.IsFeatured).Take(4).ToList();

        _skillCount = (await SkillService.GetAllAsync()).Count;

        if (_experiences.Count > 0)
        {
            var earliest = _experiences.Min(e => e.StartDate);
            _yearsExperience = (int)((DateTime.UtcNow - earliest).TotalDays / 365.25);
            _companyCount = _experiences.Select(e => e.Company.Trim().ToLowerInvariant()).Distinct().Count();
        }
        _loading = false;
    }
}
