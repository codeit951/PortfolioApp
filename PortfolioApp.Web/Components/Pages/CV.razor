@page "/cv"
@rendermode InteractiveServer
@inject IUserProfileService ProfileService
@inject IExperienceService ExperienceService
@inject IQualificationService QualService
@inject ISkillService SkillService
@inject IJSRuntime JS

<PageMeta Title="CV — {name}" Description="Curriculum vitae of {name}, {title}." />

<header class="page-head tone-rust no-print">
    <div class="container d-flex flex-wrap align-items-end justify-content-between gap-3">
        <div>
            <h1 class="page-title reveal">CV</h1>
            <p class="lede reveal-2">
                Everything on one page.
                @(string.IsNullOrEmpty(_profile?.CvFileUrl) ? "Print it or save it as a PDF from the print dialog." : "Print it or download the PDF.")
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2 reveal-2">
            @if (!string.IsNullOrEmpty(_profile?.CvFileUrl))
            {
                <a href="@_profile.CvFileUrl" download class="btn-accent"><i class="bi bi-download" aria-hidden="true"></i>Download PDF</a>
            }
            <button type="button" class="btn-outline-accent" @onclick='() => JS.InvokeVoidAsync("print")'>
                <i class="bi bi-printer" aria-hidden="true"></i>Print
            </button>
        </div>
    </div>
</header>

<section class="section">
    <div class="container">
        @if (_loading)
        {
            <div class="skeleton"><span></span><span></span><span></span><span></span></div>
        }
        else
        {
            <article class="cv-sheet reveal-2">
                <header class="cv-header">
                    @if (!string.IsNullOrEmpty(_profile?.ProfileImageUrl))
                    {
                        <img src="@_profile.ProfileImageUrl" alt="" onerror="this.style.display='none'" />
                    }
                    <div>
                        <h2 class="cv-name">@_profile?.FullName</h2>
                        <div class="text-ink-2">@_profile?.Title</div>
                        <div class="cv-contact">
                            @if (!string.IsNullOrEmpty(_profile?.Email))
                            {
                                <a href="mailto:@_profile.Email">@_profile.Email</a>
                            }
                            @if (!string.IsNullOrEmpty(_profile?.Phone))
                            {
                                <span>@_profile.Phone</span>
                            }
                            @if (!string.IsNullOrEmpty(_profile?.Location))
                            {
                                <span>@_profile.Location</span>
                            }
                            @if (!string.IsNullOrEmpty(_profile?.GitHubUrl))
                            {
                                <a href="@_profile.GitHubUrl" target="_blank" rel="noopener">@DisplayUrl(_profile.GitHubUrl)</a>
                            }
                            @if (!string.IsNullOrEmpty(_profile?.LinkedInUrl))
                            {
                                <a href="@_profile.LinkedInUrl" target="_blank" rel="noopener">@DisplayUrl(_profile.LinkedInUrl)</a>
                            }
                        </div>
                    </div>
                </header>

                @if (!string.IsNullOrEmpty(_profile?.Summary))
                {
                    <section class="cv-section">
                        <h2>Summary</h2>
                        <p class="prose mb-0">@_profile.Summary</p>
                    </section>
                }

                @if (_experiences.Count > 0)
                {
                    <section class="cv-section">
                        <h2>Experience</h2>
                        <ol class="entries">
                            @foreach (var exp in _experiences)
                            {
                                <ExperienceEntry Experience="exp" />
                            }
                        </ol>
                    </section>
                }

                @if (_qualifications.Count > 0)
                {
                    <section class="cv-section">
                        <h2>Education &amp; certifications</h2>
                        <ol class="entries">
                            @foreach (var qual in _qualifications)
                            {
                                <QualificationEntry Qualification="qual" />
                            }
                        </ol>
                    </section>
                }

                @if (_skills.Count > 0)
                {
                    <section class="cv-section">
                        <h2>Skills</h2>
                        <dl class="mb-0">
                            @foreach (var (category, skills) in _skills)
                            {
                                <div class="entry">
                                    <dt class="entry-when">@category</dt>
                                    <dd class="mb-0 text-ink-2">@string.Join(", ", skills.Select(s => s.Name))</dd>
                                </div>
                            }
                        </dl>
                    </section>
                }
            </article>
        }
    </div>
</section>

@code {
    private UserProfile? _profile;
    private List<PortfolioApp.Domain.Entities.Experience> _experiences = new();
    private List<Qualification> _qualifications = new();
    private Dictionary<string, List<Skill>> _skills = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _profile = await ProfileService.GetProfileAsync();
        _experiences = await ExperienceService.GetAllAsync();
        _qualifications = await QualService.GetAllAsync();
        _skills = await SkillService.GetGroupedByCategory();
        _loading = false;
    }

    // "https://github.com/someone/" -> "github.com/someone"
    private static string DisplayUrl(string url) =>
        url.Replace("https://", "").Replace("http://", "").Replace("www.", "").TrimEnd('/');
}
