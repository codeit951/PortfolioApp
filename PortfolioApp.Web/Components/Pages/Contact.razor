@page "/contact"
@rendermode InteractiveServer
@inject IMessageService MessageService
@inject IUserProfileService ProfileService
@inject ILogger<Contact> Logger

<PageMeta Title="Contact — {name}" Description="Get in touch with {name}." />

<header class="page-head tone-rust">
    <div class="container">
        <h1 class="page-title reveal">Contact</h1>
        <p class="lede reveal-2">Questions, projects or roles: send a message and I'll reply by email.</p>
    </div>
</header>

<section class="section">
    <div class="container split">
        <div class="split-label reveal">
            @if (_profile is not null)
            {
                <dl class="contact-details mt-0">
                    @if (!string.IsNullOrEmpty(_profile.Email))
                    {
                        <div><dt>Email</dt><dd><a href="mailto:@_profile.Email" class="text-link">@_profile.Email</a></dd></div>
                    }
                    @if (!string.IsNullOrEmpty(_profile.Phone))
                    {
                        <div><dt>Phone</dt><dd><a href="tel:@_profile.Phone" class="text-link">@_profile.Phone</a></dd></div>
                    }
                    @if (!string.IsNullOrEmpty(_profile.Location))
                    {
                        <div><dt>Based in</dt><dd>@_profile.Location</dd></div>
                    }
                    @if (!string.IsNullOrEmpty(_profile.GitHubUrl) || !string.IsNullOrEmpty(_profile.LinkedInUrl) || !string.IsNullOrEmpty(_profile.TwitterUrl))
                    {
                        <div>
                            <dt>Elsewhere</dt>
                            <dd class="link-row mt-1">
                                @if (!string.IsNullOrEmpty(_profile.GitHubUrl))
                                {
                                    <a href="@_profile.GitHubUrl" target="_blank" rel="noopener" class="text-link">GitHub <span class="arrow" aria-hidden="true">↗</span></a>
                                }
                                @if (!string.IsNullOrEmpty(_profile.LinkedInUrl))
                                {
                                    <a href="@_profile.LinkedInUrl" target="_blank" rel="noopener" class="text-link">LinkedIn <span class="arrow" aria-hidden="true">↗</span></a>
                                }
                                @if (!string.IsNullOrEmpty(_profile.TwitterUrl))
                                {
                                    <a href="@_profile.TwitterUrl" target="_blank" rel="noopener" class="text-link">X <span class="arrow" aria-hidden="true">↗</span></a>
                                }
                            </dd>
                        </div>
                    }
                </dl>
            }
        </div>

        <div class="reveal-2 form-measure">
            @if (_sent)
            {
                <div class="panel is-success" role="status">
                    <h2 class="section-title mb-2">Thanks, message received</h2>
                    <p class="text-ink-2 mb-4">I'll reply to the email address you gave, usually within a couple of days.</p>
                    <button class="btn-outline-accent" @onclick="SendAnother">Send another message</button>
                </div>
            }
            else
            {
                <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="panel">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label" for="c-name">Name</label>
                            <InputText id="c-name" class="form-control" @bind-Value="_model.Name" autocomplete="name" />
                            <ValidationMessage For="() => _model.Name" class="small mt-1" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="c-email">Email</label>
                            <InputText id="c-email" type="email" class="form-control" @bind-Value="_model.Email" autocomplete="email" />
                            <ValidationMessage For="() => _model.Email" class="small mt-1" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="c-subject">Subject <span class="text-muted fw-normal">(optional)</span></label>
                            <InputText id="c-subject" class="form-control" @bind-Value="_model.Subject" />
                            <ValidationMessage For="() => _model.Subject" class="small mt-1" />
                        </div>
                        @* Honeypot: hidden from people, but bots that fill every field will fill it. *@
                        <div class="contact-hp" aria-hidden="true">
                            <label for="website">Website</label>
                            <InputText id="website" @bind-Value="_model.Website" tabindex="-1" autocomplete="off" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="c-message">Message</label>
                            <InputTextArea id="c-message" class="form-control" @bind-Value="_model.Content" rows="6" />
                            <ValidationMessage For="() => _model.Content" class="small mt-1" />
                        </div>
                        @if (!string.IsNullOrEmpty(_error))
                        {
                            <div class="col-12">
                                <div class="notice" role="alert">@_error</div>
                            </div>
                        }
                        <div class="col-12 d-flex flex-wrap align-items-center gap-3 pt-1">
                            <button type="submit" class="btn-accent" disabled="@_submitting">
                                @(_submitting ? "Sending…" : "Send message")
                            </button>
                            <span class="text-muted small">All fields except subject are required.</span>
                        </div>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</section>

@code {
    // Submissions faster than this after the form appears are treated as bots.
    private static readonly TimeSpan MinimumFillTime = TimeSpan.FromSeconds(3);

    private ContactModel _model = new();
    private UserProfile? _profile;
    private bool _submitting;
    private bool _sent;
    private string? _error;
    private DateTime _formShownAt = DateTime.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        _profile = await ProfileService.GetProfileAsync();
        _formShownAt = DateTime.UtcNow;
    }

    private async Task SubmitAsync()
    {
        _error = null;

        // Silently "succeed" for bots so they get no signal to adapt to.
        if (!string.IsNullOrEmpty(_model.Website) || DateTime.UtcNow - _formShownAt < MinimumFillTime)
        {
            Logger.LogInformation("Contact form submission dropped by spam filter.");
            ShowSent();
            return;
        }

        _submitting = true;
        try
        {
            await MessageService.CreateAsync(new Message
            {
                Name = _model.Name.Trim(),
                Email = _model.Email.Trim(),
                Subject = _model.Subject.Trim(),
                Content = _model.Content.Trim()
            });
            ShowSent();
        }
        catch (RateLimitExceededException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save contact message");
            _error = "Failed to send message. Please try again.";
        }
        finally { _submitting = false; }
    }

    private void ShowSent()
    {
        _sent = true;
        _model = new();
    }

    private void SendAnother()
    {
        _sent = false;
        _formShownAt = DateTime.UtcNow;
    }

    private class ContactModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Name is required")]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email")]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.MaxLength(300, ErrorMessage = "Subject must be 300 characters or fewer")]
        public string Subject { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Message is required")]
        [System.ComponentModel.DataAnnotations.MinLength(10, ErrorMessage = "Message must be at least 10 characters")]
        [System.ComponentModel.DataAnnotations.MaxLength(3000, ErrorMessage = "Message must be 3000 characters or fewer")]
        public string Content { get; set; } = string.Empty;

        /// <summary>Honeypot field; real visitors never see or fill it.</summary>
        public string Website { get; set; } = string.Empty;
    }
}
