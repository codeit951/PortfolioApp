<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <script>
        // Apply the theme before first paint: saved choice, otherwise the OS preference.
        (function () {
            try {
                var saved = localStorage.getItem('theme');
                if (!saved) {
                    var legacy = localStorage.getItem('darkMode');
                    if (legacy !== null) saved = legacy === 'false' ? 'light' : 'dark';
                }
                var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
                document.documentElement.setAttribute('data-bs-theme', dark ? 'dark' : 'light');
            } catch (e) {
                document.documentElement.setAttribute('data-bs-theme', 'light');
            }
        })();
    </script>
    <meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141412" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="css/color.css" />
    <link rel="stylesheet" href="PortfolioApp.Web.styles.css" />
    <HeadOutlet />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Routes />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script>
        window.isDarkMode = function () {
            return document.documentElement.getAttribute('data-bs-theme') === 'dark';
        };
        window.toggleDarkMode = function (isDark) {
            document.documentElement.setAttribute('data-bs-theme', isDark ? 'dark' : 'light');
            try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) { }
        };

        // Keep the theme across Blazor's enhanced (in-place) page navigations.
        function reapplyTheme() {
            var t = null;
            try { t = localStorage.getItem('theme'); } catch (e) { }
            if (t) document.documentElement.setAttribute('data-bs-theme', t);
        }
        // Scroll reveal: elements with data-reveal fade up the first time they enter the viewport.
        // A data-shown attribute (not a class) marks them, so Blazor re-renders don't undo it.
        var revealSupported = 'IntersectionObserver' in window &&
            !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var revealObserver = revealSupported ? new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                // Reveal when visible, or immediately if the reader has already scrolled past it.
                if (!entry.isIntersecting && entry.boundingClientRect.top > 0) return;
                entry.target.setAttribute('data-shown', '');
                revealObserver.unobserve(entry.target);
            });
        }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 }) : null;

        function scanReveal(root) {
            if (!revealObserver || !root.querySelectorAll) return;
            if (root.matches && root.matches('[data-reveal]:not([data-shown])')) revealObserver.observe(root);
            root.querySelectorAll('[data-reveal]:not([data-shown])').forEach(function (el) { revealObserver.observe(el); });
        }
        if (revealObserver) {
            document.documentElement.classList.add('reveal-ready');
            scanReveal(document);
            new MutationObserver(function (mutations) {
                mutations.forEach(function (m) {
                    m.addedNodes.forEach(function (n) { if (n.nodeType === 1) scanReveal(n); });
                });
            }).observe(document.body, { childList: true, subtree: true });
        }

        if (window.Blazor && Blazor.addEventListener) Blazor.addEventListener('enhancedload', function () {
            reapplyTheme();
            if (revealObserver) {
                document.documentElement.classList.add('reveal-ready');
                scanReveal(document);
            }
            // Close the mobile menu after navigating.
            var open = document.querySelector('#navMain.show, #adminMobileNav.show');
            if (open && window.bootstrap) bootstrap.Collapse.getOrCreateInstance(open).hide();
        });

        // Close the mobile menus when a link inside them is tapped.
        document.addEventListener('click', function (e) {
            var link = e.target.closest('#navMain a, #adminMobileNav a');
            if (!link || !window.bootstrap) return;
            var menu = link.closest('.collapse.show');
            if (menu) bootstrap.Collapse.getOrCreateInstance(menu).hide();
        });
    </script>
</body>
</html>
